# ==========================================================
# ThinkSpace Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ==========================================================

# ─── App ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:3001

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://thinkspace:thinkspace@localhost:5432/thinkspace

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────
# Generate secure random strings: openssl rand -hex 64
JWT_SECRET=change_this_to_a_secure_random_string_at_least_64_chars
JWT_REFRESH_SECRET=change_this_to_another_secure_random_string_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (SMTP) ──────────────────────────────────────────
# Dev: use Mailtrap (mailtrap.io) — free sandbox
# Prod: use SendGrid / Resend / Postmark
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@thinkspace.app

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
